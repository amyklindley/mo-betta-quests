# Copy to alert.env. Who gets the DM when a nightly scrape looks wrong, and which bot sends it.
# Your Discord user id: User Settings -> Advanced -> Developer Mode on, then right-click your name -> Copy User ID.
ALERT_USER_ID=
# A .env file holding DISCORD_TOKEN for a bot that shares a server with you (Mo Betta or Castle Quartermaster).
ALERT_TOKEN_FILE=..\mobetta-bot\.env
